---
import type { Pillar } from '../data/pillars';
import StatCard from './StatCard.astro';
import InsightCard from './InsightCard.astro';

interface Props {
	pillar: Pillar;
	reverse?: boolean;
}

const { pillar, reverse = false } = Astro.props;
---

<section id={pillar.id} class="pillar">
	<div class="container">
		<header class="pillar-header">
			<p class="eyebrow" style={{ '--dot-color': `var(--color-${pillar.color})` }}>
				<span class="dot"></span>
				{pillar.tag}
			</p>
			<h2>{pillar.title}</h2>
		</header>

		<div class:list={['intro-grid', { reverse }]}>
			<figure class="image-frame">
				<img src={pillar.image} alt={pillar.imageAlt} loading="lazy" />
				<figcaption>{pillar.imageCaption}</figcaption>
			</figure>
			<div class="intro-copy">
				<p class="description">{pillar.description}</p>
				<div class="stat-row">
					{pillar.stats.map((stat) => <StatCard value={stat.value} label={stat.label} color={pillar.color} />)}
				</div>
			</div>
		</div>

		<div class="insight-grid">
			<InsightCard insight={pillar.good} kind="good" />
			<InsightCard insight={pillar.bad} kind="bad" />
			<InsightCard insight={pillar.expected} kind="expected" />
		</div>
	</div>
</section>

<style>
	.pillar:nth-of-type(even) {
		background: color-mix(in srgb, var(--color-surface) 60%, #f6f2fb);
	}

	.pillar-header {
		max-width: 60ch;
		margin-bottom: 2rem;
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--dot-color);
	}

	h2 {
		margin: 0.5rem 0 0;
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 800;
		letter-spacing: -0.01em;
	}

	.intro-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2.5rem;
		align-items: center;
		margin-bottom: 2.5rem;
	}

	.intro-grid.reverse {
		direction: rtl;
	}

	.intro-grid.reverse > * {
		direction: ltr;
	}

	.image-frame {
		margin: 0;
		border-radius: var(--radius-lg);
		overflow: hidden;
		box-shadow: var(--shadow-soft);
		position: relative;
	}

	.image-frame img {
		width: 100%;
		height: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
	}

	.image-frame figcaption {
		position: absolute;
		left: 1rem;
		bottom: 1rem;
		background: rgba(15, 15, 20, 0.55);
		color: white;
		font-size: 0.72rem;
		font-weight: 700;
		padding: 0.4rem 0.8rem;
		border-radius: var(--radius-pill);
		backdrop-filter: blur(6px);
	}

	.description {
		font-size: 1.02rem;
		color: var(--color-text-muted);
		margin: 0 0 1.5rem;
	}

	.stat-row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
	}

	.insight-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1.25rem;
	}

	@media (max-width: 900px) {
		.intro-grid,
		.intro-grid.reverse {
			grid-template-columns: 1fr;
			direction: ltr;
		}

		.insight-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 560px) {
		.stat-row {
			grid-template-columns: 1fr;
		}
	}
</style>
