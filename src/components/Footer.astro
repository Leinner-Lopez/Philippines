---
import { pillars } from '../data/pillars';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<p>© {year} The Philippines — Editorial Country Profile.</p>
		<ul>
			{
				pillars.map((pillar) => (
					<li>
						<a href={`/#${pillar.id}`}>{pillar.navLabel}</a>
					</li>
				))
			}
			<li>
				<a href="/memoria">Memory Game</a>
			</li>
		</ul>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--color-border);
		padding-block: 2rem;
	}

	.footer-grid {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	p {
		margin: 0;
		font-size: 0.82rem;
		color: var(--color-text-muted);
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.2rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		font-size: 0.82rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--color-text-muted);
	}
</style>
