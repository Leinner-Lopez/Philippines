---
interface Props {
	value: string;
	label: string;
	color?: 'primary' | 'secondary' | 'tertiary';
}

const { value, label, color = 'primary' } = Astro.props;
---

<div class="stat-card" style={{ '--accent': `var(--color-${color})` }}>
	<span class="value">{value}</span>
	<span class="label">{label}</span>
</div>

<style>
	.stat-card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 1.1rem 1.25rem;
		box-shadow: var(--shadow-card);
	}

	.value {
		display: block;
		font-size: 1.6rem;
		font-weight: 800;
		color: var(--accent);
	}

	.label {
		display: block;
		margin-top: 0.25rem;
		font-size: 0.78rem;
		color: var(--color-text-muted);
		font-weight: 600;
	}
</style>
