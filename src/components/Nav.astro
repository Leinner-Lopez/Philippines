---
import { pillars } from '../data/pillars';
---

<header class="nav-wrap">
	<div class="container">
		<nav class="nav-pill">
			<a class="brand" href="/#top">
				<span class="brand-title">PHILIPPINES</span>
				<span class="brand-subtitle">Country Profile</span>
			</a>
			<ul class="nav-links">
				{
					pillars.map((pillar) => (
						<li>
							<a href={`/#${pillar.id}`}>
								<span class="dot" style={{ background: `var(--color-${pillar.color})` }} />
								{pillar.navLabel}
							</a>
						</li>
					))
				}
				<li>
					<a href="/memoria">
						<span class="dot" style={{ background: 'var(--gradient-brand)' }} />
						Memory Game
					</a>
				</li>
			</ul>
			<a class="cta" href="/#briefing">2026 Overview</a>
		</nav>
	</div>
</header>

<style>
	.nav-wrap {
		position: sticky;
		top: 0.9rem;
		z-index: 40;
	}

	.nav-pill {
		display: flex;
		align-items: center;
		gap: 1rem;
		background: color-mix(in srgb, var(--color-surface) 88%, transparent);
		backdrop-filter: blur(14px);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		padding: 0.55rem 0.6rem 0.55rem 1.1rem;
		box-shadow: var(--shadow-card);
	}

	.brand {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
		text-decoration: none;
		margin-right: 0.5rem;
		white-space: nowrap;
	}

	.brand-title {
		font-size: 0.78rem;
		font-weight: 800;
		letter-spacing: 0.05em;
	}

	.brand-subtitle {
		font-size: 0.65rem;
		color: var(--color-text-muted);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		list-style: none;
		margin: 0;
		padding: 0;
		flex: 1;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.nav-links::-webkit-scrollbar {
		display: none;
	}

	.nav-links a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
		color: var(--color-text);
	}

	.dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		flex-shrink: 0;
	}

	.cta {
		flex-shrink: 0;
		background: var(--gradient-brand);
		color: white;
		font-size: 0.78rem;
		font-weight: 700;
		text-decoration: none;
		padding: 0.6rem 1.1rem;
		border-radius: var(--radius-pill);
		white-space: nowrap;
	}

	@media (max-width: 860px) {
		.nav-links {
			display: none;
		}
	}
</style>
